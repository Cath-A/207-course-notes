@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
    - title : String
    - catalogueNumber : String
    + getTitle() : String
    + getCatalogueNumber() : String
}

interface Borrowable {
    + borrow() : void
}

class Book {
    - loanPeriod : int = 21
}

class DVD {
    - loanPeriod : int = 7
}

class ReferenceOnlyItem

abstract class LibraryUser {
    - memberNumber : String
    + logIn() : void
}

class Member {
    + placeHold(item : Item) : Hold
}

class Librarian {
    + addItem(item : Item) : void
    + waiveLateFee(member : Member) : void
}

class Hold {
    - datePlaced : String
    - item : Item
    - member : Member
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceOnlyItem

Borrowable <|.. Book
Borrowable <|.. DVD

LibraryUser <|-- Member
LibraryUser <|-- Librarian

Member "1" -- "0..*" Hold : places
Item "1" -- "0..*" Hold : held for

@enduml